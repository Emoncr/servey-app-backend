# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/serveyapp

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-at-least-16-chars
JWT_EXPIRES_IN=7d

# Client origin used for CORS (comma separated for multiple origins)
CLIENT_URL=http://localhost:3000

# Seed admin credentials (used by `npm run seed`)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
